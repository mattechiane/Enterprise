{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project ENTERPRISE",
  "version": "1.0.0",
  "identifier": "com.mattechiane.enterprise",
  "build": {
    "beforeDevCommand": "npm run prepare:dist",
    "beforeBuildCommand": "npm run prepare:dist",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project ENTERPRISE — Flight Dynamics Suite",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
